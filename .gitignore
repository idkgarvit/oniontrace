# Generated output -- regenerate with the documented commands. Nothing here is source.
out/*

# Gate working directory -- case data, audit trail, permits. Never commit casework.
casework/

# The manuscript and its build are local only. The published repository is the project
# itself: the paper, its PDF and the demo video are not distributed here. `paper/` is
# ignored so a local build cannot be added back by accident.
paper/

# College reports, proposals and agent handoff notes stay local. GitHub carries the
# working project, not the paperwork around it.
docs/
HANDOFF.md

# Title-slide names and IDs are read from this file at build time; the example is what a
# clone uses to learn the shape, not a licence to publish somebody's identifiers.
deck_identity.json

# A raw certificate-transparency scrape: 432 third-party onion addresses that the repo does
# not need to ship. The aggregates beside it are the citable artefacts; this file is a cache
# the scripts rebuild on demand.
data/evidence/real_world/_ct_cache.json

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# LaTeX build byproducts (regenerated by paper/build_ieee.py + pdflatex)
paper/ieee/*.aux
paper/ieee/*.log
paper/ieee/*.out
paper/ieee/*.blg
paper/ieee/*.bbl

# Generated farm output -- regenerate with `python -m farm generate`
# `out/*` rather than `out/`, so the exclusion does not cover the directory itself and
# the negation below can re-include a subdirectory. `out/` would make git skip the whole
# tree and never see the rule underneath it.
out/*
# ...except the paper data drop, which is a citable artefact and must be durable.
!out/paper-drop/

# Gate working directory -- case data, audit trail, permits. Never commit casework.
casework/

# The manuscript and its build are local only. The published repository is the project
# itself: the paper, its PDF and the demo video are not distributed here. `paper/` is
# ignored so a local build cannot be added back by accident.
paper/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# LaTeX build byproducts (regenerated by paper/build_ieee.py + pdflatex)
paper/ieee/*.aux
paper/ieee/*.log
paper/ieee/*.out
paper/ieee/*.blg
paper/ieee/*.bbl

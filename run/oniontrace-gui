#!/usr/bin/env bash
# ONIONTRACE console -- open the analyst console in a window of its own.
#
# The console is a local service (127.0.0.1, loopback only) plus a window that points at it.
# This starts the service on a free port, waits until it answers, opens a Chromium app window
# with no address bar and no tabs, and stops the service when the window closes -- so clicking
# the entry leaves nothing running behind it.
#
# Usage:
#   run/oniontrace-gui                 # the window
#   run/oniontrace-gui --case CASE-1   # open a specific case instead of the index
#   run/oniontrace-gui --demo          # nothing to pass today; accepted so a symlink that is
#                                      # called with it does not fail
#
# Exit: 0 window opened and closed | 1 no interpreter or no project root | 2 no window shell
set -euo pipefail

WM_CLASS="oniontrace"
WINDOW_SIZE="1440x900"
PROFILE="${XDG_CACHE_HOME:-$HOME/.cache}/oniontrace-gui-profile"

say()  { printf '\033[1;36m[oniontrace]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[oniontrace]\033[0m %s\n' "$*" >&2; }
note() { printf '\033[1;36m[oniontrace]\033[0m %s\n' "$*"; }

resolve_root() {
    if [[ -n "${ONIONTRACE_PREFIX:-}" && -d "${ONIONTRACE_PREFIX}/dashboard" ]]; then
        printf '%s\n' "$ONIONTRACE_PREFIX"; return 0
    fi
    local here; here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
    if [[ -d "${here}/dashboard" ]]; then printf '%s\n' "$here"; return 0; fi
    if [[ -d /opt/oniontrace/dashboard ]]; then printf '%s\n' /opt/oniontrace; return 0; fi
    return 1
}

resolve_python() {
    local root="$1"
    if [[ -x "${root}/.venv/bin/python" ]]; then printf '%s\n' "${root}/.venv/bin/python"; return 0; fi
    if command -v python3 >/dev/null 2>&1; then printf '%s\n' python3; return 0; fi
    return 1
}

#: A port the kernel says is free right now. The window between closing this socket and uvicorn
#: binding is small, and the readiness loop below turns a lost race into a clear message rather
#: than a window pointed at nothing.
free_port() {
    "$@" - <<'PY'
import socket
with socket.socket() as s:
    s.bind(("127.0.0.1", 0))
    print(s.getsockname()[1])
PY
}

#: Chromium keeps a singleton lock in its profile. A window that was killed, or a machine that
#: lost power, leaves it behind; the next launch then finds the lock, decides another instance
#: owns the profile, hands its URL to that instance and exits -- so the launcher does nothing and
#: looks broken. Clear it only when nothing is using the profile.
clear_stale_lock() {
    local profile="$1"
    [[ -e "$profile/SingletonLock" ]] || return 0
    if ! pgrep -f "user-data-dir=$profile" >/dev/null 2>&1; then
        rm -f "$profile/SingletonLock" "$profile/SingletonSocket" "$profile/SingletonCookie" 2>/dev/null
        note "cleared a stale window-shell lock left by a previous run"
    fi
    return 0
}

main() {
    local root python
    root="$(resolve_root)" || { warn "cannot find the ONIONTRACE project root"; return 1; }
    python="$(resolve_python "$root")" || { warn "no python3 interpreter found"; return 1; }

    local case_path=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --case) case_path="/case/${2:-}"; shift 2 ;;
            --demo) shift ;;                       # accepted, no effect: there is no demo mode
            -h|--help) sed -n '2,20p' "${BASH_SOURCE[0]}"; return 0 ;;
            *) warn "unknown argument: $1"; return 1 ;;
        esac
    done

    local port log
    port="$(free_port "$python")"
    [[ -n "$port" ]] || { warn "could not find a free port"; return 1; }
    log="$(mktemp -t oniontrace-gui-XXXXXX.log)"

    ( cd "$root" && ONIONTRACE_PORT="$port" "$python" -m dashboard ) >"$log" 2>&1 &
    local server_pid=$!
    # ${server_pid:-}: an EXIT trap runs in the global scope, where a `local` is not visible, and
    # `set -u` turns that into a crash on the way out.
    trap 'kill "${server_pid:-}" 2>/dev/null || true; rm -f "$log"' EXIT

    local url="" waited=0
    while [[ $waited -lt 150 ]]; do
        if "$python" - "$port" <<'PY' >/dev/null 2>&1
import socket, sys
with socket.create_connection(("127.0.0.1", int(sys.argv[1])), timeout=0.5):
    pass
PY
        then url="http://127.0.0.1:${port}${case_path}/"; break; fi
        if ! kill -0 "$server_pid" 2>/dev/null; then
            warn "the console service exited before it was ready:"
            sed 's/^/    /' "$log" >&2
            return 1
        fi
        sleep 0.1; waited=$((waited + 1))
    done
    [[ -n "$url" ]] || { warn "the console service did not answer in time"; sed 's/^/    /' "$log" >&2; return 1; }

    say "console ready at 127.0.0.1:${port}${case_path}"

    if command -v chromium >/dev/null 2>&1; then
        clear_stale_lock "$PROFILE"
        chromium --app="$url" --class="$WM_CLASS" --window-size="$WINDOW_SIZE" \
            --user-data-dir="$PROFILE" --no-first-run --no-default-browser-check
        return $?
    fi
    if command -v google-chrome >/dev/null 2>&1; then
        clear_stale_lock "$PROFILE"
        google-chrome --app="$url" --class="$WM_CLASS" --window-size="$WINDOW_SIZE" \
            --user-data-dir="$PROFILE" --no-first-run
        return $?
    fi

    warn "no window shell found (tried chromium and google-chrome)."
    warn "the console is still running; open it yourself at:"
    warn "    $url"
    warn "press Ctrl+C here to stop it"
    wait "$server_pid"
    return 2
}

main "$@"